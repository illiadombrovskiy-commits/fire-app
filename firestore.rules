rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // личный прогресс: только сам пользователь
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // коды приглашения: код -> пользователь
    match /codes/{code} {
      // только поиск по точному коду; получить список всех кодов нельзя
      allow get: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
    }

    // почта -> пользователь (чтобы найти друга по почте Google)
    match /emails/{email} {
      // только проверка точной почты; получить список всех почт нельзя
      allow get: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.auth.token.email != null
        && email == request.auth.token.email.lower();
    }

    // карточка для друзей друзей: только имя и фото
    match /cards/{uid} {
      allow get: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'photo']);
    }

    // воодушевления: друг пишет мне одно сообщение в день, читаю и удаляю только я
    match /cheers/{to}/inbox/{id} {
      allow read, delete: if request.auth != null && request.auth.uid == to;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['from', 'name', 'photo', 'msg', 'day', 'at'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.day is string
        && request.resource.data.day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && id == request.auth.uid + '_' + request.resource.data.day
        && request.resource.data.msg is int
        && request.resource.data.msg >= 0 && request.resource.data.msg < 4
        && request.resource.data.name is string && request.resource.data.name.size() <= 60
        && request.auth.uid in get(/databases/$(database)/documents/profiles/$(to)).data.get('friends', []);
    }

    // профиль для друзей: имя, огонёк, где читает
    match /profiles/{uid} {
      // читать может сам пользователь и его друзья
      allow read: if request.auth != null
        && (request.auth.uid == uid || request.auth.uid in resource.data.get('friends', []));
      // владелец меняет свой профиль как угодно
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.get('about', '').size() <= 300;
      // другой человек может только добавить или убрать СЕБЯ из списка друзей
      allow update: if request.auth != null && request.auth.uid != uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['friends'])
        && (
          request.resource.data.friends.toSet() == resource.data.get('friends', []).toSet().union([request.auth.uid].toSet())
          || request.resource.data.friends.toSet() == resource.data.get('friends', []).toSet().difference([request.auth.uid].toSet())
        );
    }
  }
}
