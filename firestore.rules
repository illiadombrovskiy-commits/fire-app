rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // личный прогресс: только сам пользователь
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // коды приглашения: код -> пользователь
    match /codes/{code} {
      // только поиск по точному коду; получить список всех кодов нельзя
      allow get: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
    }

    // почта -> пользователь (чтобы найти друга по почте Google)
    match /emails/{email} {
      // только проверка точной почты; получить список всех почт нельзя
      allow get: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.auth.token.email != null
        && email == request.auth.token.email.lower();
    }

    // карточка для друзей друзей: только имя и фото
    match /cards/{uid} {
      allow get: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'photo']);
    }

    // воодушевления и приглашения: друг пишет мне одно сообщение каждого вида в день; читаю и удаляю только я
    match /cheers/{to}/inbox/{id} {
      allow read, delete: if request.auth != null && request.auth.uid == to;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['from', 'name', 'photo', 'msg', 'day', 'at', 'kind'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.day is string
        && request.resource.data.day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && (
          (id == request.auth.uid + '_' + request.resource.data.day && !('kind' in request.resource.data))
          || (id == request.auth.uid + '_' + request.resource.data.day + '_inv' && request.resource.data.get('kind', '') == 'invite')
          || (id == request.auth.uid + '_' + request.resource.data.day + '_conf' && request.resource.data.get('kind', '') == 'conf')
          || (id == request.auth.uid + '_' + request.resource.data.day + '_cjoin' && request.resource.data.get('kind', '') == 'confjoin')
        )
        && request.resource.data.msg is int
        && request.resource.data.msg >= 0 && request.resource.data.msg < 8
        && request.resource.data.name is string && request.resource.data.name.size() <= 60
        && request.auth.uid in get(/databases/$(database)/documents/profiles/$(to)).data.get('friends', []);
    }

    // напоминания: токен уведомлений и часовой пояс — видит и меняет только сам пользователь (рассылку делает сервер)
    match /push/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // онлайн-команды конференции «Восхождение на Синай»: документ = 6-значный код; открыть можно только по точному коду
    match /teams/{code} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if request.auth != null && code.matches('^[A-Z0-9]{6}$')
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.members == [request.auth.uid];
      // участник ведёт игру и пишет в ленту; состав не меняет, кроме выхода самого себя
      allow update: if request.auth != null && request.auth.uid in resource.data.members
        && request.resource.data.owner == resource.data.owner
        && (request.resource.data.members == resource.data.members
            || request.resource.data.members.toSet() == resource.data.members.toSet().difference([request.auth.uid].toSet()));
      // новичок может только добавить себя; в команде не больше трёх
      allow update: if request.auth != null && !(request.auth.uid in resource.data.members)
        && resource.data.members.size() < 3
        && request.resource.data.members == resource.data.members.concat([request.auth.uid])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'names', 'photos', 'feed']);
    }

    // приглашения в команду: позвать может только друг; читаю и удаляю только я
    match /teaminv/{to}/inbox/{code} {
      allow read, delete: if request.auth != null && request.auth.uid == to;
      allow create, update: if request.auth != null
        && request.resource.data.keys().hasOnly(['from', 'name', 'team', 'tname', 'at'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.team == code
        && request.auth.uid in get(/databases/$(database)/documents/profiles/$(to)).data.get('friends', []);
    }

    // глобус читателей: имя, фото, книга, огонёк и серия. Видят все вошедшие (не больше 1000 за раз); пишет и удаляет только сам человек
    match /globe/{uid} {
      allow get: if request.auth != null;
      allow list: if request.auth != null && request.query.limit <= 1000;
      allow delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'photo', 'b', 'refs', 'plan', 'streak', 'lit', 'seen', 'fc', 'spots', 'note', 'nd'])
        && request.resource.data.get('note', '') is string && request.resource.data.get('note', '').size() <= 40
        && request.resource.data.get('nd', '') is string && request.resource.data.get('nd', '').size() <= 10
        && request.resource.data.get('spots', []) is list && request.resource.data.get('spots', []).size() <= 3
        && request.resource.data.name is string && request.resource.data.name.size() <= 60
        && request.resource.data.photo is string && request.resource.data.photo.size() <= 20000
        && request.resource.data.b is int && request.resource.data.b >= -2 && request.resource.data.b < 66
        && request.resource.data.refs is list && request.resource.data.refs.size() <= 3
        && request.resource.data.plan is string && request.resource.data.plan.size() <= 60
        && request.resource.data.streak is int
        && request.resource.data.lit is string && request.resource.data.lit.size() <= 10
        && request.resource.data.seen is string && request.resource.data.seen.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.fc is int;
    }

    // профиль: любой вошедший пользователь может посмотреть (чтобы решить, добавлять ли в друзья)
    // жизненные группы «читать вместе»: документ = 6-значный код. Открыть по коду может любой вошедший (для приглашения),
    // список — только своих групп. Название, книгу, размер, ссылку и созвоны меняет только создатель.
    match /groups/{code} {
      allow get: if request.auth != null;
      allow list: if request.auth != null && request.auth.uid in resource.data.members;
      allow create: if request.auth != null && code.matches('^[A-Z0-9]{6}$')
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.members == [request.auth.uid]
        && request.resource.data.size in [2, 4, 6]
        && (!('g' in request.resource.data) || request.resource.data.g in ['m', 'f']);
      // создатель: всё, кроме состава (состав — только уйти самому, передав группу следующему)
      allow update: if request.auth != null && request.auth.uid == resource.data.owner
        && request.resource.data.size in [2, 4, 6]
        && request.resource.data.get('g', '') == resource.data.get('g', '')
        && request.resource.data.members.size() <= request.resource.data.size
        && (request.resource.data.members == resource.data.members
            || (request.resource.data.members.toSet() == resource.data.members.toSet().difference([request.auth.uid].toSet())
                && request.resource.data.owner in request.resource.data.members));
      // участник: отметки, стихи, «подбодрить», звонок, своё имя и фото; может уйти сам
      allow update: if request.auth != null && request.auth.uid in resource.data.members
        && request.auth.uid != resource.data.owner
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['day', 'reads', 'verses', 'cheers', 'live', 'names', 'photos', 'members'])
        && (request.resource.data.members == resource.data.members
            || request.resource.data.members.toSet() == resource.data.members.toSet().difference([request.auth.uid].toSet()));
      // новичок по ссылке: только добавить себя, пока есть места; в новую группу (с полем g) — только своего пола
      allow update: if request.auth != null && !(request.auth.uid in resource.data.members)
        && resource.data.members.size() < resource.data.size
        && (!('g' in resource.data) || get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.get('gender', '') == resource.data.g)
        && request.resource.data.members == resource.data.members.concat([request.auth.uid])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'names', 'photos']);
      // удалить группу: создатель или последний ушедший
      allow delete: if request.auth != null && (request.auth.uid == resource.data.owner || resource.data.members == [request.auth.uid]);
    }

    // приглашения в жизненную группу: позвать может друг, который сам в этой группе; читаю и удаляю я,
    // а пригласивший может проверить своё приглашение и отозвать его
    match /groupinv/{to}/inbox/{code} {
      allow list: if request.auth != null && request.auth.uid == to;
      allow get: if request.auth != null && (request.auth.uid == to || resource == null || resource.data.from == request.auth.uid);
      allow delete: if request.auth != null && (request.auth.uid == to || resource.data.from == request.auth.uid);
      allow create, update: if request.auth != null
        && request.resource.data.keys().hasOnly(['from', 'name', 'photo', 'group', 'gname', 'at'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.group == code
        && request.auth.uid in get(/databases/$(database)/documents/profiles/$(to)).data.get('friends', [])
        && request.auth.uid in get(/databases/$(database)/documents/groups/$(code)).data.members;
    }

    match /profiles/{uid} {
      allow get: if request.auth != null;
      // список всех профилей получить нельзя — только конкретный по ID
      allow list: if false;
      // владелец меняет свой профиль как угодно
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.get('about', '').size() <= 300
        && (!('gender' in request.resource.data) || request.resource.data.gender in ['m', 'f']);
      // другой человек может только подписаться / отписаться (добавить или убрать СЕБЯ в followers)
      allow update: if request.auth != null && request.auth.uid != uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followers'])
        && (
          request.resource.data.followers.toSet() == resource.data.get('followers', []).toSet().union([request.auth.uid].toSet())
          || request.resource.data.followers.toSet() == resource.data.get('followers', []).toSet().difference([request.auth.uid].toSet())
        );
      // дружба: убрать себя из друзей можно всегда; добавить себя — только если этот человек сам подал мне заявку (подписан на меня)
      allow update: if request.auth != null && request.auth.uid != uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['friends'])
        && (
          request.resource.data.friends.toSet() == resource.data.get('friends', []).toSet().difference([request.auth.uid].toSet())
          || (request.resource.data.friends.toSet() == resource.data.get('friends', []).toSet().union([request.auth.uid].toSet())
              && request.auth.uid in resource.data.get('following', []))
        );
    }
  }
}
